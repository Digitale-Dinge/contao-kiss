<?xml version="1.0" encoding="UTF-8"?>
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.3/phpunit.xsd"
        colors="true"
        bootstrap="vendor/autoload.php"
        cacheDirectory=".phpunit.cache"
        beStrictAboutChangesToGlobalState="true"
        displayDetailsOnTestsThatTriggerDeprecations="true"
        displayDetailsOnTestsThatTriggerErrors="true"
        displayDetailsOnTestsThatTriggerNotices="true"
        displayDetailsOnTestsThatTriggerWarnings="true"
        displayDetailsOnPhpunitDeprecations="true"
        displayDetailsOnPhpunitNotices="true"
>
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>./src</directory>
        </include>
        <exclude>
            <!-- exclude resources that are exempt from testing -->
            <directory>./src/Migration/Version*</directory>
        </exclude>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[self]=0"/>
    </php>

    <testsuites>
        <testsuite name="contao-kiss">
            <directory>./tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
