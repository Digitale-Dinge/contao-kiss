{% extends '@Contao/mod_article' %}

{% set wrapperAttributes = attrs(wrapperAttributes|default)
    .addClass(styles.background(backgroundColor|default))
%}

{% set inside_attributes = attrs()
    .addClass([
        'inside',
        styles.container(contentWidth|default ?: null),
        styles.padding_top(paddingTop|default),
        styles.padding_bottom(paddingBottom|default),
    ])
    .mergeWith(inside_attributes|default)
%}

{% block content %}
    {% if not noMarkup %}
        <div{{ inside_attributes }}>
            {{ parent() }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
