{% block image %}
    {% set item = item|default(_context) %}

    {% if item.singleSRC|default %}
        {{ include('@Contao/component/_figure.html.twig', {
            figure: figure(item.singleSRC, size|default, configuration|default({})),
            img_attributes: { class: img_class|default }
        }, false) }}
    {% endif %}
{% endblock %}
