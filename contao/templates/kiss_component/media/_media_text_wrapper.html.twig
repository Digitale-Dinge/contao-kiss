{% extends '@Contao/kiss_component/media/_media_text.html.twig' %}
{% use '@Contao/kiss_component/card/_card_attributes.html.twig' %}

{% if addImage|default %}
    {% set type = addImage ? 'image' : null %}
    {% set img_class = 'w-full' %}
{% endif %}

{% set attributes = attrs()
    .mergeWith(block('card_attributes'), show_as_card|default)
    .addClass('media-' ~ styles.media_layout(data.elementLayout|default), data.elementLayout|default)
    .mergeWith(attributes|default)
%}

{% block headline %}
    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{% block media_text %}
    <{{ tag_name|default('div') }}{% block attributes %}{{ attrs(attributes|default).addClass(['media_text', 'responsive-body-sm']) }}{% endblock %}>
        {{ parent() }}
    </{{ tag_name|default('div') }}>
{% endblock %}
