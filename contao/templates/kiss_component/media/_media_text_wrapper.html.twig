{% extends '@Contao/kiss_component/media/_media_text.html.twig' %}

{% if addImage|default %}
    {% set type = addImage ? 'image' : null %}
    {% set img_class = 'w-full' %}
{% endif %}

{% if show_as_card|default %}
    {% set attributes = attrs().addClass('card').mergeWith(attributes|default) %}
    {% set text_attributes = attrs().addClass(['card-body', 'responsive-body3']).mergeWith(text_attributes|default) %}
    {% set headline_classes = attrs().addClass('responsive-headline3').mergeWith(headline_classes|default) %}
{% endif %}

{% block headline %}
    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{% block media_text %}
    <{{ tag_name|default('div') }}{% block attributes %}{{ attrs(attributes|default).addClass(['media_text', 'responsive-body3']) }}{% endblock %}>
        {{ parent() }}
    </{{ tag_name|default('div') }}>
{% endblock %}
