{% block image %}
    {% if figure|default %}
        {% set figure_object = figure %}
    {% elseif item.singleSRC|default %}
        {% set item = item|default(_context) %}
        {% set figure_object = figure(item.singleSRC, size|default, configuration|default({})) %}
    {% endif %}

    {% if figure_object|default %}
        {{ include('@Contao/component/_figure.html.twig', {
            figure: figure_object,
            img_attributes: { class: img_class|default }
        }, false) }}
    {% endif %}
{% endblock %}
