{#
  KISS Text Component (rich text, or the call to action when there is no text)

  @param {string} text - Rich text (insert tags allowed)
  @param {string} callToAction - Serialized call to action rows, rendered when `text` is empty
  @param {HtmlAttributes} text_inner_attrs - Attributes on the rich text wrapper

  Every value is read from `item`, falling back to the context. The `text_additional` block renders after the text.

  Usage:
  {% use '@Contao/kiss_component/media/_text.html.twig' %}
  {{ block('text') }}
#}

{% block text %}
    {% set item = item|default(_context) %}

    {% if item.text|default %}
        {{ include('@Contao/component/_rich_text.html.twig', {
            text: item.text,
            attributes: text_inner_attrs|default,
        }) }}
    {% elseif (item.callToAction|default) %}
        {% use '@Contao/kiss_component/action/_call_to_action.html.twig' %}
        {{ block('call_to_action') }}
    {% endif %}
    {% block text_additional %}{% endblock %}
{% endblock %}
