{#
  KISS Icon Rich Text Component

  @param {string} icon - icon path for svg_icon()
  @param {string} text - rich text next to the icon
  @param {string} iconStyle - IconStyle value (default, badge: icon in a badge)
  @param {HtmlAttributes} icon_rich_text_attributes - additional attributes
  @param {HtmlAttributes} badge_attributes - attributes of the badge (iconStyle badge)
  @param {HtmlAttributes} text_inner_attrs - attributes of the rich text element (.rte)

  All values are read from `item`; the caller passes it with `with`.

  Usage:
  {% use '@Contao/kiss_component/media/_icon_rich_text.html.twig' %}
  {% with {item: {icon: …, text: …, iconStyle: …}} %}
      {{ block('icon_rich_text') }}
  {% endwith %}
#}

{% use '@Contao/kiss_component/media/_text.html.twig' %}
{% use '@Contao/kiss_component/status/_badge.html.twig' %}

{% block icon_rich_text %}
    {% set icon_style = enum('DigitaleDinge\\ContaoKiss\\Styles\\Option\\IconStyle').tryFrom(item.iconStyle|default)?.name %}

    <div{{ attrs(icon_rich_text_attributes|default).addClass('icon_rich_text') }}>
        {% if item.icon|default and icon_style == 'badge' %}
            {% with {item: {icon: item.icon, badgeSize: 'large'}} %}
                {{ block('badge') }}
            {% endwith %}
        {% elseif item.icon|default %}
            {{ include('@Contao/kiss_component/media/_icon_include.html.twig', {icon: item.icon}) }}
        {% endif %}
        {% with {item: {
            text: item.text|default,
            callToAction: item.callToAction|default,
            textAppearance: item.textAppearance|default,
        }} %}
            {{ block('text') }}
        {% endwith %}
    </div>
{% endblock %}
