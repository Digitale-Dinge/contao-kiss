{% use '@Contao/kiss_component/media/_text.html.twig' %}

{% block media_text %}
    {% set item = item|default(_context) %}
    {% set show_as_card = show_as_card|default(data.showAsCard|default) %}
    {% set hide_figcaption = hide_figcaption|default(show_as_card) %}
    {% set media_type = media_type|default(mediaType|default) %}

    {% block media %}
        {% if media_type in ['image', 'icon', 'video'] %}
            {% set media_attributes = attrs()
                .addClass('card-media', show_as_card)
                .addClass(['media-' ~ media_type, 'media'])
                .mergeWith(media_attributes|default)
            %}
            {# ToDo: Add image size fallback if not set -> 800px if as card -> 800 or 600 if as gridlist #}
            {{ include("@Contao/kiss_component/media/_#{media_type}.html.twig") }}
        {% endif %}
    {% endblock %}

    {% if item.text|default or headline.text %}
        <div{{ attrs()
            .addClass(['card-body', 'responsive-body-sm'], show_as_card)
            .addClass('text')
            .mergeWith(text_attributes|default)
        }}>
            {% with {headline_classes: attrs(headline_classes|default)
                .addClass(['card-title', 'responsive-headline-sm'], show_as_card)}
            %}
                {% block headline %}{% endblock %}
            {% endwith %}
            {{ block('text') }}
        </div>
    {% endif %}
{% endblock %}
