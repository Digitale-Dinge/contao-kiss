{% use '@Contao/kiss_component/action/_action.html.twig' %}

{% block call_to_action %}
    {% set call_to_action = item is defined
        ? (item.callToAction|default)
        : (data.callToAction|default)
    %}
    {% set actions = call_to_action|deserialize %}
    {% if actions|length %}
        <div{{ attrs().addClass(['cta-outer', 'flex', 'flex-wrap', 'gap-2', 'md:gap-4', 'mt-3']).mergeWith(cta_wrapper_attributes|default) }}>
            {% for action in actions %}
                {% with action only %}
                    {{ block('action') }}
                {% endwith %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
