{% use '@Contao/kiss_component/action/_action.html.twig' %}

{% block call_to_action %}
    {% set call_to_action = item is defined
        ? (item.callToAction|default)
        : (data.callToAction|default)
    %}
    {% set actions = call_to_action|deserialize %}
    {% if actions|length and actions|first.text|default %}
        {% set cta_wrapper_attributes = attrs()
            .addClass(['cta-outer', 'inline-flex', 'flex-wrap', 'gap-2', 'md:gap-4', 'mt-3'])
            .mergeWith(cta_wrapper_attributes|default)
        %}
        <div{{ cta_wrapper_attributes }}>
            {% for action in actions %}
                {% with {
                    text: action.text|default,
                    url: action.url|default,
                    target: action.target|default,
                    ctaType: action.ctaType|default,
                    ctaColor: action.ctaColor|default,
                    ctaSize: action.ctaSize|default,
                    ctaShape: action.ctaShape|default,
                    loopIndex: loop.index,
                    loopLength: actions|length,
                } %}
                    {{ block('action') }}
                {% endwith %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
