{#
  KISS Action Component (one link or button)

  @param {string} text - Link text (insert tags allowed)
  @param {string} url - Link target (insert tags allowed)
  @param {bool} target - Open in a new window
  @param {string} rel - Lightbox group, emitted as data-lightbox
  @param {string} ctaType - Key from Component\CallToAction\Variant, or `none` for a plain link
  @param {string} ctaColor - Key from Color
  @param {string} ctaSize - Key from Modifier\Size
  @param {string} ctaShape - Key from Component\CallToAction\Shape
  @param {HtmlAttributes} cta_attributes - Attributes on the link

  Values are read top-level; `_call_to_action` maps one row per call with `with`.

  Usage:
  {% use '@Contao/kiss_component/action/_action.html.twig' %}
  {% with {text: row.text, url: row.url} %}{{ block('action') }}{% endwith %}
#}

{% block action %}
    {% if text|default %}
        {% set cta_attributes = attrs(cta_attributes|default)
            .set('href', url|default|insert_tag|encode_email)
            .set('target', '_blank', target|default)
            .set('rel', 'noreferrer noopener')
            .setIfExists('data-lightbox', rel|default)
            .addClass('cta', 'none' == ctaType|default)
            .addClass('btn', 'none' != ctaType|default)
            .addClass('btn-' ~ styles.cta_variant(ctaType|default), ctaType|default not in ['', 'none'])
            .addClass('btn-' ~ styles.size(ctaSize), ctaSize|default)
            .addClass('btn-' ~ styles.color(ctaColor), ctaColor|default)
            .addClass(styles.cta_shape(ctaShape|default))
        %}
        <a{{ cta_attributes }}>{{ text|encode_email|insert_tag_raw }}</a>
    {% endif %}
{% endblock %}
