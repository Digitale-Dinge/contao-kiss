{% block content_wrapper %}
    {% set list_mode = list|default is iterable and list|length or data.gridColumns|default or data.gridRatioActive|default %}
    {% set list_tag_name = list_tag_name|default('div') %}

    {% if list_mode %}
        {% if data.gridRatioActive|default %}
            {# The grid is the .grid-ratio div one level down, so pass Gap and
               Cross-alignment to it as inherited custom properties. #}
            {% set gap = styles.gap(gridGap|default(data.gridGap|default)) %}
            {% set cross_alignment = styles.crossAlignment(gridCrossAlignment|default(data.gridCrossAlignment|default)) %}
            {% set list_wrapper_attributes = attrs(list_wrapper_attributes|default) %}
            {% if gap %}
                {% set list_wrapper_attributes = list_wrapper_attributes.addStyle('--grid-ratio-gap: calc(var(--spacing) * ' ~ (gap|split('-')|last) ~ ')') %}
            {% endif %}
            {% if cross_alignment %}
                {% set list_wrapper_attributes = list_wrapper_attributes.addStyle('--grid-ratio-align: ' ~ (cross_alignment|split('-')|last)) %}
            {% endif %}
        {% else %}
            {% set cols = gridColumns|default(data.gridColumns|default) %}
            {% if cols is not empty %}
                {% import '@Contao/kiss_component/grid/_macro.html.twig' as grid %}
                {% set cols_key = styles.column(cols)  %}
                {% set gap = styles.gap(gridGap|default(data.gridGap|default)) %}
                {% set cross_alignment = styles.crossAlignment(gridCrossAlignment|default(data.gridCrossAlignment|default)) %}
                {% set list_wrapper_attributes = attrs(list_wrapper_attributes|default)
                    .addClass(['grid', grid.get_cols_class(cols_key), gap, cross_alignment])
                %}
            {% endif %}
        {% endif %}
        <{{ list_tag_name }}{{ attrs(list_wrapper_attributes|default).addClass('list') }}>
    {% endif %}
    {% block content %}{% endblock %}
    {% if list_mode %}
        </{{ list_tag_name }}>
    {% endif %}
{% endblock %}
