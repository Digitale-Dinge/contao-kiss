{% block content_wrapper %}
    {% set list_mode = list|default is iterable and list|length or data.gridColumns|default %}
    {% set list_tag_name = list_tag_name|default('div') %}

    {% if list_mode %}
        {% set cols = gridColumns|default(data.gridColumns|default) %}
        {% if cols is not empty %}
            {% import '@Contao/kiss_component/grid/_macro.html.twig' as grid %}
            {% set gap = styles.gap(gridGap|default(data.gridGap|default)) %}

            {# Custom column ratio (only for 2 or 3 columns): "3-7" -> "3fr 7fr".
               gridColumns stores enum case names (e.g. "two"); styles.column()
               resolves them to "cols_N", from which we read the column count. #}
            {% set cols_key = styles.column(cols) %}
            {% set col_count = (cols_key ~ '')|slice(5) %}
            {% set ratio = gridRatio|default(data.gridRatio|default) %}
            {% set ratio_parts = ratio is not empty ? ratio|split('-') : [] %}

            {% if col_count in ['2', '3'] and ratio_parts|length == col_count %}
                {% set grid_cols = ratio_parts|map(v => v ~ 'fr')|join(' ') %}
                {% set list_wrapper_attributes = attrs(list_wrapper_attributes|default)
                    .addClass(['grid', 'grid-ratio', gap])
                    .addStyle('--grid-cols: ' ~ grid_cols)
                %}
            {% else %}
                {% set list_wrapper_attributes = attrs(list_wrapper_attributes|default)
                    .addClass(['grid', grid.get_cols_class(cols_key), gap])
                %}
            {% endif %}
        {% endif %}
        <{{ list_tag_name }}{{ attrs(list_wrapper_attributes|default).addClass('list') }}>
    {% endif %}
    {% block content %}{% endblock %}
    {% if list_mode %}
        </{{ list_tag_name }}>
    {% endif %}
{% endblock %}
