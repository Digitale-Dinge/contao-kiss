{% block content_wrapper %}

    {% set list_mode = list|default is iterable and list|length %}
    {% set list_tag_name = list_tag_name|default('div') %}

    {% if list_mode %}
        {% import '@Contao/kiss_component/_grid_macro.html.twig' as grid %}
        {% set cols_key = styles.column(gridColumns|default)  %}
        {% set list_wrapper_attributes = attrs(list_wrapper_attributes|default)
            .addClass(['grid', grid.get_cols_class(cols_key), styles.gap(gridGap|default)])
        %}
        <{{ list_tag_name }}{{ attrs(list_wrapper_attributes).addClass('list') }}>
    {% endif %}
    {% block content %}{% endblock %}
    {% if list_mode %}
        </{{ list_tag_name }}>
    {% endif %}
{% endblock %}
