{#
  KISS Alert Component Template

  @param {string} title - Alert title/heading
  @param {string} description - Alert message/description
  @param {string} message - Alert message (backward compatibility with 'description')
  @param {string} color - Alert color variant: primary|secondary|tertiary|success|warning|error
  @param {string} style - Alert style: soft|outline|dashed (default: solid)
  @param {string} icon - Icon key, rendered via the SVG icon picker
  @param {string} class - Additional CSS classes

  Usage:
  {% include 'components/_alert.html.twig' with {
    title: 'Success!',
    description: 'Your changes have been saved.',
    color: 'success',
    style: 'soft',
    icon: 'check-circle'
  } only %}
#}

{% set alertClasses = [
  'alert',
  color|default ? 'alert-' ~ color : '',
  style|default ? 'alert-' ~ style : '',
  class|default,
]|filter(v => v)|join(' ') %}

<div class="{{ alertClasses }}" role="alert">
  {% if icon|default %}
    <span class="alert-icon">
      {{ include('@Contao/kiss_component/media/_icon_include.html.twig', {
        icon: icon
      }) }}
    </span>
  {% endif %}

  <div class="alert-content">
    {% if title|default %}
      <div class="alert-title">{{ title }}</div>
    {% endif %}

    {% if description|default %}
      <div class="alert-description">{{ description|raw }}</div>
    {% elseif message|default %}
      <div class="alert-description">{{ message|raw }}</div>
    {% endif %}

    {% block alert_content %}{% endblock %}
  </div>
</div>
