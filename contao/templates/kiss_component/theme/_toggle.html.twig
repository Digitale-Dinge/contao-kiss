{#
 # Animated Sun/Moon Theme Toggle
 #
 # Usage:
 #   {{ include('@Contao/kiss_component/theme/_toggle.html.twig') }}
 #
 # With custom size:
 #   {{ include('@Contao/kiss_component/theme/_toggle.html.twig', {size: 32}) }}
 #
 # With custom classes:
 #   {{ include('@Contao/kiss_component/theme/_toggle.html.twig', {class: 'my-custom-class'}) }}
 #
 # With custom attributes:
 #   {{ include('@Contao/kiss_component/theme/_toggle.html.twig', {attributes: {'data-tooltip': 'Toggle theme'}}) }}
 #}

{% set size = size|default(24) %}
{% set id = 'moon-mask-' ~ random() %}

{# ToDo: Add translations for the aria label #}
{% set buttonAttributes = attrs()
    .set('data-controller', 'theme')
    .set('data-action', 'theme#toggle')
    .addClass(['theme-toggle', class|default])
    .set('type', 'button')
    .set('aria-label', 'Toggle dark mode')
    .mergeWith(attributes|default)
%}

<button{{ buttonAttributes }}>
    {% block theme_toggle_icon %}
        <svg
            class="theme-toggle__icon"
            viewBox="0 0 24 24"
            width="{{ size }}"
            height="{{ size }}"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            {# Sun rays - hidden in dark mode #}
            <g class="theme-toggle__rays">
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </g>
            {# Moon mask - creates crescent effect in dark mode #}
            <defs>
                <mask id="{{ id }}">
                    <rect x="0" y="0" width="100%" height="100%" fill="white"/>
                    <circle class="theme-toggle__mask" cx="18" cy="12" r="8" fill="black"/>
                </mask>
            </defs>
            {# Sun/Moon circle #}
            <circle
                class="theme-toggle__circle"
                cx="12"
                cy="12"
                r="5"
                fill="currentColor"
                stroke="none"
                mask="url(#{{ id }})"/>
        </svg>
    {% endblock %}
</button>
