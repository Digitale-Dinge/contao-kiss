{% macro cols_class(cols) %}
    {% set map = {
        1: 'grid-cols-1',
        2: 'grid-cols-1 sm:grid-cols-2',
        3: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3',
        4: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
        5: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5',
        6: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6',
        7: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-7',
        8: 'grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8',
        9: 'grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9',
        10: 'grid-cols-3 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-10',
        11: 'grid-cols-3 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-11',
        12: 'grid-cols-4 sm:grid-cols-6 md:grid-cols-9 lg:grid-cols-12',
    } %}
    {{- map[cols]|default -}}
{% endmacro %}

{% macro get_cols_class(key) %}
    {% set cols = key[5:] %}
    {{- _self.cols_class(cols)}}
{% endmacro %}
