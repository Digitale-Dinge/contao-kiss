{# Erweitert das Legacy-Template fe_page.html5 #}
{% extends "@Contao/fe_page.html5" %}
{% set class = class ~ ' text-base' %}


{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/files/frontend/dist/css/styles.css">
{% endblock %}

{% block header %}
	<header id="header">
	{% include '@Contao_DigitaleDingeContaoKissBundle/partials/page/headaer/_meta.html.twig' %}
	{% include '@Contao_DigitaleDingeContaoKissBundle/partials/page/headaer/_main.html.twig' %}
	{{ parent() }}
	</header>
{% endblock %}

{% block footer %}
	<footer id="footer">
		<div id="footer-wrapper">
			{% include '@Contao_DigitaleDingeContaoKissBundle/partials/page/footer/_main.html.twig' %}
		</div>
		{% include '@Contao_DigitaleDingeContaoKissBundle/partials/page/footer/_meta.html.twig' %}
	</footer>
	{{ parent() }}
{% endblock %}