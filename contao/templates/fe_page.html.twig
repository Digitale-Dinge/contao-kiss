{# Erweitert das Legacy-Template fe_page.html5 #}
{% extends "@Contao/fe_page.html5" %}
{% set class = class ~ ' text-base' %}


{% block head %}
	{{ parent() }}
{% endblock %}

{% block header %}
	<header id="header" class="bg-header">
		{% include [
			'@Contao/partials/page/header/_meta.html.twig',
			'@Contao_DigitaleDingeContaoKissBundle/partials/page/header/_meta.html.twig'
			
		] ignore missing %}
		{% include [
			'@Contao/partials/page/header/_main.html.twig',
			'@Contao_DigitaleDingeContaoKissBundle/partials/page/header/_main.html.twig'
		] ignore missing %}
	</header>
{% endblock %}

{% block footer %}
	<footer id="footer" class="bg-footer">
		<div id="footer-wrapper">
			{% include [
				'@Contao/partials/page/footer/_main.html.twig',
				'@Contao_DigitaleDingeContaoKissBundle/partials/page/footer/_main.html.twig'
			] ignore missing %}
		</div>
	</footer>
	{% include [
		'@Contao/partials/page/footer/_meta.html.twig',
		'@Contao_DigitaleDingeContaoKissBundle/partials/page/footer/_meta.html.twig'
	] ignore missing %}
{% endblock %}

{% block body %}
	{{ parent() }}
	<link rel="stylesheet" href="/files/frontend/dist/css/styles.css">
	<script src="/files/frontend/dist/js/scripts.js"></script>
{% endblock %}