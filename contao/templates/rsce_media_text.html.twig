{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/kiss_component/_media_text.html.twig' %}

{% set attributes = attrs(attributes|default).addClass('media_text') %}

{% block headline %}
    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{%- block inner %}
    {% block content %}
        {{ block('media_text') }}
    {% endblock %}
{% endblock -%}
