{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/kiss_component/media/_media_text.html.twig' %}
{% use '@Contao/kiss_component/card/_card_attributes.html.twig' %}

{% set type = 'media_text' %}

{% set show_as_card = data.showAsCard|default %}
{% set layout_prefix = show_as_card ? 'card-' : 'layout-' %}

{% if not show_as_card %}
    {% set data = data|merge({backgroundColor: null}) %}
{% endif %}

{% set attributes = attrs(attributes|default)
    .addClass(['media_text', 'responsive-body3'])
    .addClass(layout_prefix ~ styles.media_layout(data.elementLayout|default), data.elementLayout|default)
    .mergeWith(block('card_attributes'), show_as_card)
%}

{% block headline %}
    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{%- block inner %}
    {% block content %}
        {{ block('media_text') }}
    {% endblock %}
{% endblock -%}
