{#
  KISS Breadcrumb Component v5.0
  ==============================
  A configurable breadcrumb component with size, color, and separator options.
  
  Configuration Options:
  ----------------------
  All options can be set via Twig variables before including/extending this template,
  or later via DCA/RSCE configuration.
  
  @var string|null breadcrumb_size     Size variant: 'xs', 'sm', 'lg', 'xl' (default: null = medium)
  @var string|null breadcrumb_color    Color variant: 'primary', 'secondary', 'accent', 'info', 'success', 'warning', 'error'
  @var string|null separator_type      Separator type: 'chevron' (default), 'slash', 'dot', 'arrow', 'custom'
  @var string|null separator_custom    Custom separator (SVG string or text) when separator_type is 'custom'
  @var int|null    max_items           Max visible items before collapsing (default: 4, 0 = never collapse)
  @var bool        collapsible         Enable/disable collapse behavior (default: true)
  
  CSS Classes Applied:
  --------------------
  - Base: .breadcrumb (from Contao wrapper)
  - Size: .breadcrumb-{xs|sm|lg|xl}
  - Color: .breadcrumb-{primary|secondary|accent|info|success|warning|error}
#}
{% extends '@Contao/mod_breadcrumb' %}

{% trans_default_domain 'contao_default' %}

{# ============================================================================
   CONFIGURATION DEFAULTS
   ============================================================================ #}
{% set breadcrumb_size = breadcrumb_size|default(null) %}
{% set breadcrumb_color = breadcrumb_color|default(null) %}
{% set separator_type = separator_type|default('chevron') %}
{% set separator_custom = separator_custom|default(null) %}
{% set max_items = max_items|default(4) %}
{% set collapsible = collapsible|default(true) %}

{# ============================================================================
   SEPARATOR ICONS
   Map separator types to their SVG representations
   ============================================================================ #}
{% set separators = {
    'chevron': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>',
    'chevron-thin': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>',
    'slash': '<span class="separator-slash">/</span>',
    'dot': '<span class="separator-dot">•</span>',
    'arrow': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>',
    'arrow-thin': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>',
    'double-chevron': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 17 5-5-5-5"/><path d="m13 17 5-5-5-5"/></svg>'
} %}

{# Resolve separator content #}
{% if separator_type == 'custom' and separator_custom %}
    {% set separator_content = separator_custom %}
{% elseif separators[separator_type] is defined %}
    {% set separator_content = separators[separator_type] %}
{% else %}
    {% set separator_content = separators['chevron'] %}
{% endif %}

{# ============================================================================
   BUILD COMPONENT CLASSES
   ============================================================================ #}
{% set component_classes = [] %}

{# Size variant #}
{% if breadcrumb_size in ['xs', 'sm', 'lg', 'xl'] %}
    {% set component_classes = component_classes|merge(['breadcrumb-' ~ breadcrumb_size]) %}
{% endif %}

{# Color variant #}
{% if breadcrumb_color in ['primary', 'secondary', 'accent', 'info', 'success', 'warning', 'error'] %}
    {% set component_classes = component_classes|merge(['breadcrumb-' ~ breadcrumb_color]) %}
{% endif %}

{# ============================================================================
   BUILD WRAPPER ATTRIBUTES
   Merge our component classes with Contao's wrapperAttributes
   ============================================================================ #}
{% set wrapperAttributes = attrs(cssID)
    .addClass([class, 'block']|merge(component_classes))
    .addStyle(style|default)
    .set('aria-label', 'MSC.breadcrumbMenu'|trans)
    .mergeWith(wrapperAttributes|default)
%}

{# Add Stimulus controller attributes if collapsible #}
{% if collapsible and max_items > 0 %}
    {% set wrapperAttributes = wrapperAttributes
        .set('data-controller', 'breadcrumb')
        .set('data-breadcrumb-max-items-value', max_items)
    %}
{% endif %}

{# ============================================================================
   TEMPLATE BLOCKS
   ============================================================================ #}
{% block content %}
    <ul>
        {% for item in items %}
            {# Add separator before each item except the first #}
            {% if not loop.first %}
                <li class="breadcrumb-separator" aria-hidden="true">{{ separator_content|raw }}</li>
            {% endif %}
            
            {# Determine if this item should be collapsible (middle items) #}
            {% set is_collapsible = collapsible and not loop.first and not loop.last %}
            
            {% if item.isActive %}
                <li aria-current="page"{{ is_collapsible ? ' data-breadcrumb-target="item"' : '' }}>
                    <a href="{{ item.href }}">{{ item.link }}</a>
                </li>
            {% else %}
                <li{{ is_collapsible ? ' data-breadcrumb-target="item"' : '' }}>
                    <a href="{{ item.href }}">{{ item.link }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endblock %}