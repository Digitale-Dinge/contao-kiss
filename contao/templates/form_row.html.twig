{% extends '@Contao/form_row.html.twig' %}

{% set type_class_map = {
    text: 'form-input',
    altcha: 'form-input',
    captcha: 'form-input',
    email: 'form-input',
    tel: 'form-input',
    url: 'form-input',
    password: 'form-input',
    date: 'form-input',

    checkbox: 'form-checkbox',

    radio: 'form-radio',

    select: 'form-select',

    textarea: 'form-textarea',

    range: 'form-range',

    upload: ['form-input', 'upload'],
} %}

{% set type_prefix_map = {
    text: 'input',
    altcha: 'input',
    captcha: 'input',
    email: 'input',
    tel: 'input',
    url: 'input',
    password: 'input',
    date: 'input',

    checkbox: 'checkbox',

    radio: 'radio',

    select: 'select',

    textarea: 'textarea',

    range: 'range',

    upload: 'upload',
} %}

{% set type_prefix = type_prefix_map[this.type]|default %}

{% set form_data = kiss_include_data() %}
{% set field_color = this.fieldColor|default(form_data.formFieldColor|default) %}
{% set field_size = this.fieldSize|default(form_data.formFieldSize|default) %}
{% set field_variant = this.fieldVariant|default(form_data.formFieldVariant|default) %}

{% set wrapperAttributes = attrs(wrapperAttributes|default)
    .addClass([styles.span(this.gridSpan|default)])
    .addClass('range-' ~ styles.color(field_color), this.type == 'range' and field_color)
%}

{% set form_inner_attributes = attrs()
    .addClass(type_class_map[this.type]|default)
    .addClass(type_prefix ~ '-' ~ styles.color(field_color), this.type != 'range' and type_prefix and field_color)
    .addClass(type_prefix ~ '-' ~ styles.size(field_size), type_prefix and field_size)
    .addClass(type_prefix ~ '-' ~ styles.variant(field_variant), type_prefix and field_variant)
    .mergeWith(form_inner_attributes|default)
%}

{% for attribute, value in form_inner_attributes %}
    {% do addAttribute.invoke(attribute, value) %}
{% endfor %}
