{% extends '@Contao/form_row.html.twig' %}

{% set type_class_map = {
    'text':     'form-input',
    'altcha':   'form-input',
    'captcha':  'form-input',
    'email':    'form-input',
    'password': 'form-input',
    'upload':   'form-input',

    'checkbox': 'form-checkbox',

    'radio':    'form-radio',

    'select':   'form-select',

    'textarea': 'form-textarea',

    'range':    'form-range',
} %}

{% set type_prefix_map = {
    'text':     'input',
    'altcha':   'input',
    'captcha':  'input',
    'email':    'input',
    'password': 'input',
    'upload':   'input',

    'checkbox': 'checkbox',

    'radio':    'radio',

    'select':   'select',

    'textarea': 'textarea',

    'range':    'range',
} %}

{% set type_prefix = type_prefix_map[this.type]|default %}

{% set wrapperAttributes = attrs(wrapperAttributes|default)
    .addClass([styles.span(this.gridSpan|default)])
    .addClass('range-' ~ styles.color(this.fieldColor|default), this.type == 'range' and this.fieldColor|default)
%}

{% set form_inner_attributes = attrs(form_inner_attributes|default)
    .addClass(type_class_map[this.type]|default)
    .addClass(type_prefix ~ '-' ~ styles.color(this.fieldColor|default), this.type != 'range' and type_prefix and this.fieldColor|default)
    .addClass(type_prefix ~ '-' ~ styles.size(this.fieldSize|default), type_prefix and this.fieldSize|default)
    .addClass(type_prefix ~ '-' ~ styles.variant(this.fieldVariant|default), type_prefix and this.fieldVariant|default)
%}

{% for attribute, value in form_inner_attributes %}
    {% do addAttribute.invoke(attribute, value) %}
{% endfor %}
