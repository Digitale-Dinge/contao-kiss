{% use '@Contao/kiss_component/media/_icon_text.html.twig' %}
{% use '@Contao/kiss_attributes/_button_attributes.html.twig' %}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set list_tag_name = 'ul' %}
{% set list_wrapper_attributes = attrs(list_wrapper_attributes|default).addClass(['gap-4', 'm-0', 'p-0', 'list-none']) %}

{% set link_attributes = attrs(link_attributes|default).mergeWith(block('button_attributes'), data.ctaAsButton|default) %}

{% block hyperlink_list_item %}
    {% set link_title = item.linkTitle|default(item.url) %}

    <a{{ attrs(link_attributes|default)
        .addClass(['inline-flex', 'items-center', '[&_svg]:h-[1em]', '[&_svg]:w-[1em]', '[&_svg]:shrink-0'])
        .set('href', item.url|default|insert_tag|encode_email)
        .set('target', '_blank', item.target|default)
        .set('rel', 'noreferrer noopener', item.target|default)
    }}>
        {% if item.icon|default %}
            {% with {item: data, icon: item.icon, text: link_title} %}
                {{ block('icon_text') }}
            {% endwith %}
        {% else %}
            {{ link_title|insert_tag }}
        {% endif %}
    </a>
{% endblock %}

{% block content %}
    {% for item in list %}
        <li>{{ block('hyperlink_list_item') }}</li>
    {% endfor %}
{% endblock %}
