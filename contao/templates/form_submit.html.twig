{% extends '@Contao/form_submit.html.twig' %}

{% set form_data = kiss_include_data() %}
{% set button_color = this.fieldColor|default(form_data.formFieldColor|default) %}
{% set button_size = this.fieldSize|default(form_data.formFieldSize|default) %}
{% set button_variant = this.fieldVariant|default(form_data.formFieldButtonVariant|default) %}

{% set wrapperAttributes = attrs(wrapperAttributes|default)
    .addClass(styles.font_appearance(this.textAppearance|default), this.textAppearance|default)
    .addClass(styles.text_alignment(this.textAlignment|default), this.textAlignment|default)
%}

{% set form_inner_attributes = attrs(form_inner_attributes|default)
    .addClass('btn')
    .addClass('btn-' ~ styles.color(button_color), button_color)
    .addClass('btn-' ~ styles.size(button_size), button_size)
    .addClass(styles.cta_shape(this.fieldShape|default), this.fieldShape|default)
    .addClass('btn-' ~ styles.cta_variant(button_variant), button_variant)
%}
