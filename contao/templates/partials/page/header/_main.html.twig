{% set header_main_attributes = attrs()
    .addClass(['header-main','relative','py-8','text-sm'])
%}

{% set header_inside_attributes = attrs()
    .addClass(['inside', 'flex', 'gap-x-4', 'items-center', 'justify-between'])
    .addClass(getContainerClass())
%}

<div{{ header_main_attributes }}>
    <div{{ header_inside_attributes }}>
        {{ header|raw }}
    </div>
</div>
