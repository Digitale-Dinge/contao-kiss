{% use '@Contao/company/info.html.twig' %}
{% use '@Contao/company/contact.html.twig' %}

{% block footer_main %}
<div{{ attrs().addClass(['inside', 'container-base']) }}>
    <div{{ attrs().addClass([
        'footer-content',
        'flex',
        'flex-col',
        'min-[500px]:flex-row',
        'gap-16',
        'min-[880px]:gap-4',
        'min-[880px]:justify-between',
        'pb-16',
    ]) }}>
        <div{{ attrs().addClass(['footer-address']) }}>
            <p{{ attrs().addClass(['text-sm']) }}>
                {{ block('company_info') }}
            </p>
            <p{{ attrs().addClass(['text-sm']) }}>
                {{ block('company_contact') }}
            </p>
            <p>
                {# Social Media Nav #}
                {{ frontend_module(7) }}
            </p>
        </div>
        <div class="footer-nav">
                {# Footer Main Nav – Horizontal Nav #}
                {{ frontend_module(8) }}
        </div>
    </div>
</div>
{% endblock %}
