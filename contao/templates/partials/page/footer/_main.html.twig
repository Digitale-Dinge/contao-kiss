{% block footer_main %}
    <div{{ attrs().addClass(['inside', styles.container]).mergeWith(footer_main_inside_attributes|default) }}>
        {% block footer_main_inside %}
            <div{{ attrs().addClass(['footer-nav']).mergeWith(footer_main_navigation_attributes|default) }}>
                {% block footer_main_navigation %}
                    {{ frontend_module('navigation', {
                        levelOffset: 0,
                        showLevel: footer_navigation_level|default(1),
                        hardLimit: true,
                        ariaLabel: 'aria_label.footer'|trans([], 'contao_kiss'),
                        cssID: { 1: 'mod_navigation--horizontal' },
                    }) }}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
