
<div class="inside container-base">
	<div class="footer-social max-w-5xl mx-auto px-4">
		{{ frontend_module(7) }}
	</div>
	<div class="footer-content flex flex-col min-[500px]:flex-row gap-16 min-[880px]:gap-4 min-[880px]:justify-between pb-16">
		<div class="footer-address text-grey">
			<h3 class="mt-2 text-base leading-snug text-white uppercase">{{ insert_tag('company::name')|raw }}</h3>
			<p class="text-sm">
				{{ insert_tag('company::info')|raw }}<br>
				{{ insert_tag('company::street')|raw }}<br>
				{{ insert_tag('company::postal')|raw }}&nbsp;{{ insert_tag('company::city')|raw }}
			</p>
			<p class="text-sm">
				{{ insert_tag('company::mailto')|raw }}<br>
				{{ insert_tag('company::tel')|raw }}
			</p>
		</div>
		<div class="footer-nav">
				{{ frontend_module(3) }}
		</div>
	</div>
</div>
