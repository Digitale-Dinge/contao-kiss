{% set has_footer_meta_left = sections['footer-meta-left'] is defined and sections['footer-meta-left'] is not empty %}
{% set has_footer_meta_right = sections['footer-meta-right'] is defined and sections['footer-meta-right'] is not empty %}

{% if has_footer_meta_left or has_footer_meta_right %}
    <div class="footer-meta bg-footer-meta">
        <div class="container-base flex flex-col min-[880px]:flex-row max-[880px]:gap-8 justify-between align-center min-[880px]:items-center">
            {% if sections['footer-meta-left'] is defined and sections['footer-meta-left'] is not empty %}
            <div>
                {{ sections['footer-meta-left']|raw }}
            </div>
            {% endif %}
            {% if sections['footer-meta-right'] is defined and sections['footer-meta-right'] is not empty %}
                <div>
                    {{ sections['footer-meta-right']|raw }}
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
