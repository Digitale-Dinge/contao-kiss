{% extends '@Contao/block_searchable' %}
{% use '@Contao/kiss_component/_content_wrapper.html.twig' %}

{# KISS styles of the include element (module, form or article) that renders this template #}
{% set include_data = kiss_include_data() %}
{% set list_mode = list|default is iterable and list|length %}
{% set list_tag_name = list_tag_name|default('div') %}

{# cssID may not be set for specific extensions #}
{% set cssID = cssID|default %}

{% set wrapperAttributes = attrs(cssID)
    .addClass([
        styles.container(data.contentWidth|default(include_data.contentWidth|default)),
        styles.padding_top(data.paddingTop|default(include_data.paddingTop|default)),
        styles.padding_bottom(data.paddingBottom|default(include_data.paddingBottom|default)),
        styles.margin_top(data.marginTop|default(include_data.marginTop|default)),
        styles.margin_bottom(data.marginBottom|default(include_data.marginBottom|default)),
    ])
    .mergeWith(wrapperAttributes|default)
%}

{% block wrapper %}
    <div{{ wrapperAttributes }}>
        {% block headline %}
            {% if headline|default %}
                <{{ hl }}>{{ headline|insert_tag_raw }}</{{ hl }}>
            {% endif %}
        {% endblock %}
        {{ block('content_wrapper') }}
    </div>
{% endblock %}
