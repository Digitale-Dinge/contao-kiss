{% extends '@Contao/block_searchable' %}

{% set layout_classes = [
    styles.container(contentWidth|default),
    styles.padding_top(paddingTop,|default),
    styles.padding_bottom(paddingBottom|default),
    styles.margin_top(marginTop|default),
    styles.margin_bottom(marginBottom|default)
] %}

{% set has_layout_classes = layout_classes|filter(v => v)|length > 0 %}

{%- block wrapper_before %}
    {% if has_layout_classes %}
        <div{{ attrs().addClass(layout_classes) }}>
    {% endif %}
{% endblock -%}
{{ block('wrapper') }}
{%- block wrapper_after %}
    {% if has_layout_classes %}
        </div>
    {% endif %}
{% endblock -%}
