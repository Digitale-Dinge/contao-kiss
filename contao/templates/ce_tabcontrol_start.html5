<div class="<?php if($this->contentWidth): ?> <?= $this->contentWidth ?><?php endif; ?><?php if($this->paddingTop): ?> <?= $this->paddingTop ?><?php endif; ?><?php if($this->paddingBottom): ?> <?= $this->paddingBottom ?><?php endif; ?><?php if($this->marginTop): ?> <?= $this->marginTop ?><?php endif; ?><?php if($this->marginBottom): ?> <?= $this->marginBottom ?><?php endif; ?>">
    <?php $this->block('headline'); ?>
        <?php if ($this->headline): ?>
            <<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
        <?php endif; ?>
    <?php $this->endblock(); ?>
    <div class="ce_tabs">
        <div class="nav-container">
            <ul class="ce_tabs-nav " id="tabcontrol_tabs_<?= $this->id ?>" role="tablist" <?php if ($this->rememberLastTab): ?>data-remember-last-tab="true"<?php endif; ?>>
                <?php foreach ($this->tabs as $tab): ?>
                  <li class="nav-item">
                      <?php if($tab['addTabLink']): ?>
                        <a class="nav-link" id="<?= $tab['tabId'] ?>-tab" href="<?= $tab['tabLink'] ?>"<?php if($tab['openLinkInNewTab']): ?> target="_blank"<?php endif; ?>><?= $tab['headline'] ?></a>
                      <?php else: ?>
                        <a class="tab-link nav-link <?php if ($tab['active']): ?>active-tab-nav<?php endif; ?>" id="<?= $tab['tabId'] ?>-tab" href="#<?= $tab['tabId'] ?>" role="tab" aria-controls="<?= $tab['tabId'] ?>"
                           aria-selected="<?php if ($tab['active']): ?>true<?php endif; ?>"><?= $tab['headline'] ?></a>
                      <?php endif; ?>
                  </li>
                <?php endforeach; ?>
            </ul>
        </div>
        <div class="tab-content" id="tabcontrol_content_<?= $this->id ?>">
            <div class="tab-pane fade <?php if ($this->active): ?>show active-tab<?php endif; ?>" id="<?= $this->tabId ?>" role="tabpanel" aria-labelledby="<?= $this->tabId ?>-tab">
