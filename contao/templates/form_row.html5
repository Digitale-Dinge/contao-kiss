<?php

$this->wrapperAttributes = $this
		->attr()
		->addClass([
				$this->prefix,
				$this->styleManager->get('formfields', ['grid-cols'])
		])
		->mergeWith($this->wrapperAttributes)
;

?>

<div<?= $this->wrapperAttributes ?>>
  <?php $this->block('label'); ?>
  <?php $this->endblock(); ?>

  <?php $this->block('field'); ?>
  <?php $this->endblock(); ?>
</div>
