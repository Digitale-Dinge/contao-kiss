<?php $this->block('before') ?>
	<?php if ($this->contentWidth || $this->paddingTop || $this->paddingBottom || $this->marginTop || $this->marginBottom): ?>
		<div class="<?php if($this->contentWidth): ?> <?= $this->contentWidth ?><?php endif; ?><?php if($this->paddingTop): ?> <?= $this->paddingTop ?><?php endif; ?><?php if($this->paddingBottom): ?> <?= $this->paddingBottom ?><?php endif; ?><?php if($this->marginTop): ?> <?= $this->marginTop ?><?php endif; ?><?php if($this->marginBottom): ?> <?= $this->marginBottom ?><?php endif; ?>">
	<?php endif; ?>
<?php $this->endblock() ?>
<div class="<?= $this->class ?> <?php $this->block('addClass') ?><?php $this->endblock() ?>"<?= $this->cssID ?><?php if ( $this->style ): ?> style="<?= $this->style ?>"<?php endif; ?>>

    <?php $this->block( 'headline' ); ?>
        <?php if ( $this->topline ): ?>
            <p class="topline"><?= $this->topline ?></p>
        <?php endif ?>
        <?php if ( $this->headline ): ?>
            <<?= $this->hl ?> class="headline"><?= $this->headline ?></<?= $this->hl ?>>
        <?php endif; ?>
    <?php $this->endblock(); ?>

    <?php $this->block( 'content' ); ?>
    <?php $this->endblock(); ?>

</div>
<?php $this->block('after') ?>
<?php if($this->layoutCss): ?></div><?php endif; ?>
<?php $this->endblock() ?>
