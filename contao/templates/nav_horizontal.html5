<?php if( $this->level == 'level_2'): ?><div class="nav-flyout absolute hidden group-hover:block flex-col px-0 mx-0"><?php endif; ?>
	<ul class="<?php if( $this->level == 'level_1'): ?>nav--horizontal p-0 <?php endif; ?><?= $this->level ?> flex gap-4<?php if( $this->level != 'level_1'): ?> flex-col<?php endif; ?>">
		<?php foreach ($this->items as $item): ?>
			<?php if ( $item['isActive'] || $item['type'] === 'folder' ): ?>
				<li class="relative <?php if (!empty($item['subitems'])): ?>group<?php endif; ?> whitespace-nowrap <?= $item['class'] ?>">
					<strong class="w-auto gap-x-2 hover:cursor-default<?php if ( $item['type'] === 'folder' &&  empty($item['isTrail']) ): ?> text-body <?php endif; ?><?= $item['class'] ?>"
									<?php if (!empty($item['subitems'])): ?>aria-haspopup="true"<?php endif; ?>>
						<?= $item['link'] ?>
					</strong>
					<?php if ($this->level == 'level_1' && !empty($item['subitems'])): ?>
						<span class="icon icon-chevron-down text-xs font-bold inline-block transform transition-transform duration-300 group-hover:rotate-180"></span>
					<?php endif; ?>
				<?= $item['subitems'] ?? '' ?>
				</li>
			<?php else: ?>
				<li class="relative <?php if (!empty($item['subitems'])): ?>group <?php endif; ?>whitespace-nowrap <?= $item['class'] ?>">
					<a href="<?= $item['href'] ?>" title="<?= $item['pageTitle'] ?: $item['title'] ?>"
						<?php if ($item['class']): ?>class="<?= $item['class'] ?>"<?php endif; ?>
						<?php if ('' !== $item['accesskey']): ?>accesskey="<?= $item['accesskey'] ?>"<?php endif; ?>
						<?= $item['target'] ?><?= $item['rel'] ?? '' ?>
						<?php if (!empty($item['subitems'])): ?>aria-haspopup="true"<?php endif; ?>>
						<?= $item['link'] ?>
					</a>
					<?php if ($this->level == 'level_1' && !empty($item['subitems'])): ?>
						<span class="icon icon-chevron-down text-xs font-bold inline-block transform transition-transform duration-300 group-hover:rotate-180"></span>
					<?php endif; ?>
					<?= $item['subitems'] ?? '' ?>
				</li>
			<?php endif; ?>
		<?php endforeach; ?>
	</ul>
<?php if( $this->level == 'level_2'): ?></div><?php endif; ?>