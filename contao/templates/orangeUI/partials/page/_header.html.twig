<header id="header">
	<div class="header-meta z-10 relative py-1 bg-muted">
		<div class="inside flex items-center justify-between {{ getContainerClass() }} text-xs">
			{{ frontend_module(4) }}
			<div class="flex items-center align-center">
				<div class="hidden min-[480px]:block">
					{{ frontend_module(5) }}
				</div>
				<div class="mod_changelanguage__wrapper ml-4 pl-4 cursor-pointer group relative min-[480px]:border-l-1 border-solid border-muted-foreground/20">
					<div class="flex items-center align-center gap-2">
						<span class="icon icon-earth-language"></span>
						{% if contao.page.language =="de" %}
							<span class="mod_changelanguage--active lang-de">Deutsch</span>
						{% elseif contao.page.language =="en" %}
							<span class="mod_changelanguage--active lang-en">English</span>
						{% endif %}
					</div>
					<div class="hidden group-hover:block group-hover:pointer-events-auto absolute left-1/2 -translate-x-1/2 pointer-events-none transition-opacity duration-300">{{ frontend_module(6) }}</div>
				</div>
			</div>
		</div>
	</div>
	<div class="header-main z-9 relative py-8 text-sm">
		<div class="inside flex gap-4 items-center justify-between {{ getContainerClass() }}">
			{{ frontend_module(1) }}
			<div class="hidden md:block">
				{{ frontend_module(2) }}
			</div>
			<div class="block md:hidden leading-none">
				{#<a href="#menu">Menü</a>#}
				
				<button class="hamburger hamburger--spin" type="button" aria-label="Menu" aria-controls="navigation" id="menu-toggle">
					<span class="hamburger-box">
						<span class="hamburger-inner"></span>
					</span>
				</button>
				
				{{ frontend_module(7) }}
			</div>
			{#
			<div class="formbody">
				{% include 'orangeUI/components/forms/switch/_switch.html.twig' with {
					label: 'Dark Mode',
					} %}
			</div>
			#}
		</div>
	</div>
</header>

<script>
	var hamburger = document.querySelector(".hamburger");
	hamburger.addEventListener("click", function() {
		hamburger.classList.toggle("is-active");
	});
</script>

