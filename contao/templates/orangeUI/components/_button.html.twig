{% set button_data = {} %}
{% if button.showIcon %}
    {% set button_data = button_data|merge({'icon':button.icon}) %}
    {% if button.iconPosition == 'after' %}
        {% set button_data = button_data|merge({'iconPosition':'right'}) %}
    {% endif %}
{% endif %}
{% set button_data = button_data|merge({'buttonType':button.type}) %}
{% set button_extra_class = button.class|default('') %}
{% if button.type == 'secondary' %}
    {% set button_extra_class = button_extra_class ~ ' bg-white hover:bg-tertiary text-primary' %}
{% endif %}
{% include '/content_element/hyperlink.html.twig' with {
    link_text: button.linktext,
    link_attributes: {
        'href': button.url|insert_tag,
        'class': 'btn btn-'~button.type~' '~button_extra_class~' text-base leading-snug inline-flex justify-between min-w-[19rem] mb-4 py-3 px-4 font-bold'
    },
    data: button_data
} %}