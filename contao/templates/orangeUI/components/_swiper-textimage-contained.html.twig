{% extends "/content_element/swiper.html.twig" %}

{% block slides %}
  {% for slide in slides %}
    {% set slide_attributes = attrs()
    .addClass('slider__item swiper-slide')
    .mergeWith(slide_attributes|default)
    %}
    <div{{ slide_attributes }}>
      {% if style == 'text' %}
        <div class="text-white py-8 px-6 lg:p-8 xl:p-16 {{ slide.backgroundColor }}">
          <{{ slide.headline.unit }} class="headline h3 mb-14">{{ slide.headline.value }}</{{ slide.headline.unit }}>
          <div class="text-xs lg:text-ty font-bold">{{ slide.text|raw }}</div>
        </div>
      {% else %} {# style == 'image' #}
        <div class="flex justify-center">
          {% if slide.singleSRC is defined and slide.singleSRC is not empty %}
            {% include "@Contao/component/_figure.html.twig" with {
              figure: figure(slide.singleSRC, 9),
              figure_attributes: {class:'w-full'}
            } %}
          {% endif %}
        </div>
      {% endif %}
      </div>
  {% endfor %}
{% endblock %}
