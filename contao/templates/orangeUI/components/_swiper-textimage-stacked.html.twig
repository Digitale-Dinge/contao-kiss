{% extends "/content_element/swiper.html.twig" %}

{% block slides %}

    {% for slide in slides %}

        {% set slide_attributes = attrs()
        .addClass('slider__item swiper-slide')
        .mergeWith(slide_attributes|default)
        %}
        <div{{ slide_attributes }}>

            {% if style == 'text' %}

                <div class="pr-14 pl-20 xl:py-8 flex justify-center xl:h-full">
                    <div class="my-auto">
                        <{{ slide.headline.unit }} class="headline h4">{{ slide.headline.value }}</{{ slide.headline.unit }}>
                        {{ slide.text|raw }}
                        {% if slide.url is defined and slide.url is not empty %}
													{% set link_attributes = {
															'href': slide.url|insert_tag
													} %}
													
													{% if slide.target %}
															{% set link_attributes = link_attributes|merge({
															'target': '_blank',
															'rel': 'noopener'
															}) %}
													{% endif %}
													
													{% include "@Contao/content_element/hyperlink.html.twig" with {
															link_text: slide.linkTitle|default('Mehr erfahren'),
															link_attributes: link_attributes,
															data: {
																	icon: '\e96b',
																	iconPosition: 'right'
															}
													} %}
                        {% endif %}
                        {% if slide.multiSRC is defined and slide.multiSRC is not empty %}
                        <div>

                        </div>
                        {% endif %}
                    </div>
                </div>

            {% else %} {# style == 'image' #}

                <div class="flex justify-center p-4 xl:p-0">
                    {% if slide.singleSRC is defined and slide.singleSRC is not empty %}
                        {% include "@Contao/component/_figure.html.twig" with {
                            figure: figure(slide.singleSRC, 8)
                        } %}
                    {% endif %}

                    {% if slide.sectionHeadline is defined and slide.sectionHeadline is not empty %}
                        <p>{{ slide.sectionHeadline }}</p>
                    {% endif %}
                </div>

            {% endif %}
        </div>

    {% endfor %}

{% endblock %}
