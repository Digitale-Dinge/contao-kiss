<script src="./files/frontend/dist/js/glightbox.min.js"></script>
<script<?= $this->attr()->setIfExists('nonce', $this->nonce('script-src')) ?>>
document.addEventListener('DOMContentLoaded', () => {
document.querySelectorAll('a[data-lightbox]').forEach(el => {
	const group = el.getAttribute('data-lightbox');
	if (group) {
		el.setAttribute('data-gallery', group);
	}

	// Bildtitel aus dem title-Attribut
	const title = el.getAttribute('title') || '';

	// figcaption finden (wenn vorhanden)
	let description = '';
	const figure = el.closest('figure');
	if (figure) {
		const figcaption = figure.querySelector('figcaption');
		if (figcaption) {
			description = figcaption.textContent.trim();
		}
	}

	// data-glightbox zusammenbauen
	el.setAttribute('data-glightbox', `title: ${title}; description: ${description}`);

	// Fokus-Workaround
	el.addEventListener('click', () => el.blur());
});

	// GLightbox starten
	GLightbox({
		selector: 'a[data-lightbox]',
		loop: false,
		width: '95%',
		height: 'auto',
		touchNavigation: true,
		zoomable: true,
		autoplayVideos: false
	});
});
</script>
