{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% if data.ctaAsButton|default %}
    {% set link_attributes = attrs(link_attributes|default)
        .addClass('btn')
        .addClass('btn-' ~ styles.size(data.ctaSize), data.ctaSize|default)
        .addClass('btn-' ~ styles.color(data.ctaColor), data.ctaColor|default)
        .addClass(styles.cta_type(data.ctaType|default))
        .addClass(styles.cta_shape(data.ctaShape|default))
    %}
{% endif %}

{% set link_attributes = attrs(link_attributes|default)
    .addClass('colorbox_iframe', data.lightboxIframe|default)
%}

{% block text_link %}
    {% if icon|default %}
        {{- text_before|default -}}
        {{ include('@Contao/kiss_component/media/_icon_text.html.twig') }}
        {{- text_after|default -}}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock -%}
