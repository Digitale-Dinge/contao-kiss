{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% if data.hyperlinkAsButton|default %}
    {% set link_attributes = attrs(link_attributes|default)
        .addClass('btn')
        .addClass('btn-{{ data.buttonSize }}', data.buttonSize|default)
        .addClass('btn-{{ data.buttonType }}', data.buttonType|default)
        .addClass('colorbox_iframe', data.lightboxIframe|default)
    %}
{% endif %}

{% set link_attributes = attrs(link_attributes|default)
    .addClass('colorbox_iframe', data.lightboxIframe|default)
%}

{% block text_link %}
    {% if icon|default %}
        {{- text_before|default -}}
        {{ include('@Contao/component/_icon_link.html.twig') }}
        {{- text_after|default -}}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock -%}
