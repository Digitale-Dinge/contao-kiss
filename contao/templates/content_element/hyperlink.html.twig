{% extends "@Contao/content_element/hyperlink.html.twig" %}

{% block content %}
		{% set image = null|default %}
		{{ parent() }}
{% endblock %}

{% block wrapper %}
		{% set headline = {'text':''|default} %}
		{{ parent() }}
{% endblock %}

{% block text_link %}
	{% set link_attributes = attrs().mergeWith(link_attributes|default) %}
	{% set text_before = ''|default %}
	{% set text_after = ''|default %}

	{% if data.hyperlinkAsButton is defined and data.hyperlinkAsButton is not empty %}
		{% set button_class = 'btn' %}

		{% if data.buttonSize is not empty %}
			{% set button_class = button_class ~ '-' ~ data.buttonSize %}
		{% endif %}

		{% if data.buttonType is not empty %}
			{% set button_class = button_class ~ '-' ~ data.buttonType %}
		{% else %}
			{% set button_class = 'btn' %}
		{% endif %}

		{% set link_attributes = link_attributes.addClass('btn ' ~ button_class) %}
	{% endif %}

	{% if data.lightboxIframe is defined and data.lightboxIframe is not empty %}
		{% set link_attributes = link_attributes.addClass('colorbox_iframe') %}
	{% endif %}

	{{- text_before -}}

	<a{{ attrs(link_attributes|default) }}>
		{% if data.icon is defined and (data.iconPosition is not defined or data.iconPosition == 'left') %}
			<span class="mr-1" aria-hidden="true" data-icon="&#x{{ data.icon }};"></span>
		{% endif %}

		<span class="text">
			{{ link_text|insert_tag|raw }}
		</span>

		{% if data.iconPosition is defined and data.iconPosition == 'right' %}
			<span class="ml-1" aria-hidden="true" data-icon="&#x{{ data.icon }};"></span>
		{% endif %}
	</a>

	{{- text_after -}}
{% endblock %}
