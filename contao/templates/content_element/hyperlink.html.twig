{% use '@Contao/kiss_component/media/_icon_text.html.twig' %}
{% use '@Contao/kiss_attributes/_button_attributes.html.twig' %}
{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% set link_attributes = attrs(link_attributes|default).mergeWith(block('button_attributes'), data.ctaAsButton|default) %}

{% block text_link %}
    {% if data.icon|default %}
        {% set link_attributes = attrs(link_attributes|default)
            .addClass('inline-flex items-center')
            .addClass('[&_svg]:h-[1em] [&_svg]:w-[1em] [&_svg]:shrink-0')
        %}
        {{- text_before -}}
        <a{{ attrs(link_attributes|default) }}>
            {% with {item: data, icon: data.icon, text: link_text} %}
                {{ block('icon_text') }}
            {% endwith %}
        </a>
        {{- text_after -}}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock -%}
