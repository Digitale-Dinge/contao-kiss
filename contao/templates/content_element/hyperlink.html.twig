{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% set headline = {text: null} %}

{% set link_attributes = attrs(link_attributes|default)
    .addClass('btn', data.hyperlinkAsButton|default and data.hyperlinkAsButton|default)
    .addClass('btn-{{ data.buttonSize }}', data.hyperlinkAsButton|default and data.buttonSize|default)
    .addClass('btn-{{ data.buttonType }}', data.hyperlinkAsButton|default and data.buttonType|default)
    .addClass('colorbox_iframe', data.lightboxIframe|default)
%}

{% block content %}
    {%- block text_link %}
        <a{{ attrs(link_attributes|default) }}>
            {% if data.icon|default and data.iconPosition|default == 'left' %}
                <span class="mr-1">{{ svg_icon(data.icon|default) }}</span>
            {% endif %}
            <span class="text leading-none">
                {{ link_text|insert_tag }}
            </span>
            {% if data.icon|default and data.iconPosition|default == 'right' %}
                <span class="ml-1">{{ svg_icon(data.icon|default) }}</span>
            {% endif %}
        </a>
    {% endblock -%}
{% endblock %}
