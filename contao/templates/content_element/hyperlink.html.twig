{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% if data.hyperlinkAsButton|default %}
    {% set link_attributes = attrs(link_attributes|default)
        .addClass('btn')
        .addClass(data.buttonStyle, data.buttonStyle|default)
        .addClass(data.buttonColor, data.buttonColor|default)
        .addClass(data.buttonSize, data.buttonSize|default)
        .addClass(data.buttonShape, data.buttonShape|default)
        .addClass('colorbox_iframe', data.lightboxIframe|default)
    %}
{% endif %}

{% set link_attributes = attrs(link_attributes|default)
    .addClass('colorbox_iframe', data.lightboxIframe|default)
%}

{% block text_link %}
    {% if icon|default %}
        {{- text_before|default -}}
        {{ include('@Contao/kiss_component/_icon_text.html.twig') }}
        {{- text_after|default -}}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock -%}
