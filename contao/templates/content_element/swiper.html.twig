{% extends '@Contao/content_element/swiper.html.twig' %}

{# Multi-card slider: "data.slidesPerView" is the desktop card count (tablet shows
   2, mobile 1). Empty or 1 keeps the default single full-width slider.

   The slider is wrapped in .swiper-bleed: the track sits inset from the viewport,
   neighbouring cards peek past it, and the frame clips that peek at the screen
   edge (see _swiper.scss). This needs no Swiper offsets, so it works the same with
   or without continuous/loop. #}
{% block content %}
    {% set columns = data.slidesPerView|default(0) + 0 %}

    {% if columns >= 2 %}
        {% set slider_settings = slider_settings|default({})|merge({
            slidesPerView: 1,
            spaceBetween: 24,
            pagination: false,
            breakpoints: {
                768: { slidesPerView: 2 },
                1024: { slidesPerView: min(columns, 6) },
            },
        }) %}
        <div class="swiper-bleed">{{ parent() }}</div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Hide the navigation buttons in the back-end editor view. #}
{% block controls %}
    {% if not as_editor_view %}
        {{ parent() }}
    {% endif %}
{% endblock %}
