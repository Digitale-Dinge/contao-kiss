{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/kiss_component/_content_wrapper.html.twig' %}

{% set list_mode = list|default is iterable and list|length %}
{% set list_tag_name = list_tag_name|default('div') %}

{% block attributes %}
    {% set show_as_card = show_as_card|default(data.showAsCard|default) %}
    {% set layout_prefix = show_as_card ? 'card-' : 'layout-' %}
    {% set layout_option = styles.media_layout(data.elementLayout|default)|trim %}

    {% set attributes = attrs(attributes|default)
        .addClass([
            styles.container(data.contentWidth|default),
            styles.padding_top(data.paddingTop|default),
            styles.padding_bottom(data.paddingBottom|default),
            styles.margin_top(data.marginTop|default),
            styles.margin_bottom(data.marginBottom|default),
            styles.background(data.backgroundColor|default),
            styles.text_alignment(data.textAlignment|default),
        ])
        .addClass(layout_prefix ~ layout_option, layout_option)
    %}
    {{ parent() }}
{% endblock %}

{%- block inner %}
    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}

    {{ block('content_wrapper') }}
{% endblock -%}
