{% extends '@Contao/content_element/_base.html.twig' %}

{% block content %}
    {% for fragment in nested_fragments %}
        {{ content_element(fragment) }}
    {% endfor %}
{% endblock %}

{% block style %}
    {{ parent() }}
    {% if data.gridRatioActive|default %}
        {% add 'grid-ratio' to head %}
            <style>{{ block('grid_ratio_css') }}</style>
        {% endadd %}
    {% endif %}
{% endblock %}

{# Override this block to change the breakpoint or grid behaviour. #}
{% block grid_ratio_css %}
@media (width >= 768px) {
    .grid-ratio {
        display: grid;
        grid-template-columns: var(--grid-cols, 1fr);
        gap: var(--grid-ratio-gap, 1rem);
        align-items: var(--grid-ratio-align, stretch);
    }
}
{% endblock %}
