{% extends '@Contao/content_element/text.html.twig' %}

{% set show_as_card = data.showAsCard|default %}

{% if show_as_card %}
    {% set attributes = attrs()
        .addClass('card')
        .addClass('card-' ~ styles.size(data.elementSize|default), data.elementSize|default)
        .mergeWith(attributes|default)
    %}
    {% set headline_classes = attrs().addClass('responsive-headline3').mergeWith(headline_classes|default) %}
    {% set text_attributes = attrs().addClass('responsive-body3').mergeWith(text_attributes|default) %}
{% endif %}

{% block inner %}
    {% if show_as_card %}
        <div{{ attrs(card_body_attributes|default).addClass('card-body') }}>{{ parent() }}</div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
