
{% set class = 'mod_logo' %}

{% block content %}
<div class="{{ class }}">
	{% if jumpTo is not empty %}
		<a href="{{ insert_tag('link_url::' ~ jumpTo) }}" aria-label="Logo" class="{{ class }}__link">
	{% else %}
		<div class="{{ class }}__content">
	{% endif %}
		{% if singleSRC is not empty %}
			 {% include "@Contao/component/_figure.html.twig" with {
				figure: figure(singleSRC, imgSize)
			} %} 
		{% else %}
			{{ text }}
		{% endif %}
	{% if jumpTo is not empty %}
		</a>
	{% else %}
		</div>
	{% endif %}
</div>    
{% endblock %}

