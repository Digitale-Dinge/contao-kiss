{% block company_logo %}
    {% if kiss.company.logo|default %}
        <div{{ attrs(company_logo_attributes|default).addClass('company_logo') }}>
            {{ include('@Contao/component/_figure.html.twig', {
                figure: figure(kiss.company.logo, null),
                linkHref: app.request.baseUrl,
                img_attributes: {
                    class: 'logo ' ~ logo_classes|default,
                    alt: kiss.company.name,
                },
            }) }}
        </div>
    {% endif %}
{% endblock %}
