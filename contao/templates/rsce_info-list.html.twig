{% extends '@Contao/content_element/_base.html.twig' %}

{% set attributes = attrs()
    .addClass('info_list')
    .addClass('info_list--' ~ data.listLayout|default, data.listLayout|default)
    .mergeWith(attributes|default)
%}

{% block content %}
    {% for item in list %}
        <div class="info_list__item">
            {% if item.icon|default %}
                <div class="info_list__icon">
                    {{ include('@Contao/kiss_component/media/_icon_include.html.twig', { icon: item.icon }) }}
                </div>
            {% endif %}
            <div class="info_list__content">
                {% if item.headline|default %}
                    <p class="info_list__headline">{{ item.headline|insert_tag }}</p>
                {% endif %}
                {% if item.text|default %}
                    <div class="info_list__text">{{ item.text|raw }}</div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
