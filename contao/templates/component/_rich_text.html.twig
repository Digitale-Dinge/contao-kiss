{% use '@Contao/component/_rich_text.html.twig' %}
{% use '@Contao/kiss_component/action/_call_to_action.html.twig' %}

{% block rich_text_component %}
    {% set text_appearance = item is defined
        ? (item.textAppearance|default)
        : (data.textAppearance|default)
    %}

    {% if text_appearance %}
        {% set rich_text_attributes = attrs(rich_text_attributes|default)
            .addClass(styles.font_appearance(text_appearance)|default(styles.heading(text_appearance)))
        %}
    {% endif %}
    {{ parent() }}
    {{ block('call_to_action') }}
{% endblock %}
