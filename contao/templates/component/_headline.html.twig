{% use '@Contao/component/_headline.html.twig' %}

{% block headline_component %}
    {% set is_from_iterable = item.headline|default is iterable %}
    {% set topline = item.topline|default(data.topline|default) %}

    {% if topline|default %}
        <p{{ attrs(topline_attributes|default).addClass('topline') }}>{{ topline }}</p>
    {% endif %}

    {% set headline_source = is_from_iterable ? item.headline|default : data.headline|default|deserialize %}
    {% set appearance = headline_source.appearance|default %}
    {% set attributes = headline_source.attributes|default %}

    {% set headline = {
        text: is_from_iterable ? item.headline.value : headline.text|default(headline),
        tag_name: is_from_iterable ? item.headline.unit|default : headline.tag_name|default,
        attributes: attrs(attributes).addClass(['headline', styles.font_size(appearance)|default(styles.heading(appearance))]).mergeWith(headline_classes|default)
    } %}
    {{ parent() }}
{% endblock %}
