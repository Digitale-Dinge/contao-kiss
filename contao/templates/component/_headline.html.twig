{% use '@Contao/component/_headline.html.twig' %}

{% block headline_component %}
    {% if data.topline|default %}
        <p{{ attrs(topline_attributes|default).addClass('topline') }}>{{ data.topline }}</p>
    {% endif %}

    {% set headline_fields = data.headline|default|deserialize %}
    {% set headline = {
        text: headline.text|default(headline),
        tag_name: headline.tag_name|default,
        attributes: attrs(headline.attributes|default).addClass(['headline', styles.size(headline_fields.size|default)])
    } %}

    {{ parent() }}
{% endblock %}
