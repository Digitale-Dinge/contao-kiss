{% use '@Contao/component/_headline.html.twig' %}

{% block headline_component %}
    {% if item is defined %}
        {% set topline = item.topline|default %}
    {% endif %}

    {% if topline|default %}
        <p{{ attrs(topline_attributes|default).addClass('topline') }}>{{ topline }}</p>
    {% endif %}

    {# RSCE list wrapper #}
    {% if item.headline|default is iterable %}
        {% set headline = {
            text: item.headline.value,
            tag_name: item.headline.unit|default,
            appearance: item.headline.appearance|default
        } %}
    {% else %}
        {% set appearance = (data.headline|default|deserialize).appearance|default %}
        {% set headline = {
            text: headline.text|default(headline),
            tag_name: headline.tag_name|default,
            attributes: attrs(headline.attributes|default).addClass(['headline', styles.size(appearance)|default(styles.heading(appearance))])
        } %}
    {% endif %}

    {{ parent() }}
{% endblock %}
