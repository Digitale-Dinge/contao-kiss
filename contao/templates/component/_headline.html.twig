{% use '@Contao/component/_headline.html.twig' %}

{% block headline_component %}
    {% set is_from_iterable = item.headline|default is iterable %}

    {% if item is defined %}
        {% set topline = item.topline|default %}
    {% elseif data.topline|default %}
        {% set topline = data.topline|default %}
    {% endif %}

    {% set headline_text = is_from_iterable ? item.headline.value : headline.text|default(headline) %}

    {% if headline_text and topline|default %}
        <hgroup>
    {% endif %}

    {% if topline|default %}
        <p{{ attrs(topline_attributes|default).addClass('topline') }}>{{ topline|insert_tag }}</p>
    {% endif %}

    {% set headline_source = is_from_iterable ? item.headline|default : data.headline|default|deserialize %}
    {% set appearance = headline_source.appearance|default %}
    {% set attributes = headline_source.attributes|default %}

    {% set headline = {
        text: headline_text,
        tag_name: is_from_iterable ? item.headline.unit|default : headline.tag_name|default,
        attributes: attrs(attributes).addClass(['headline', styles.font_size(appearance)|default(styles.heading(appearance)|default(styles.font_display(appearance)))]).mergeWith(headline_classes|default)
    } %}
    {{ parent() }}

    {% if headline_text and topline|default %}
        </hgroup>
    {% endif %}
{% endblock %}
