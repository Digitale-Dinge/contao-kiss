{% block icon_link %}
    <a{{ attrs(link_attributes|default) }}>
        {% if icon.position|default == 'left' %}
            {{ _self.span_icon(icon.position|default, icon) }}
        {% endif %}
        <span{{ attrs(icon_text_attributes|default).addClass(['text', 'leading-none']) }}>
            {{ link_text|insert_tag }}
        </span>
        {% if icon.position|default == 'right' %}
            {{ _self.span_icon(icon.position|default, icon) }}
        {% endif %}
    </a>
{% endblock %}

{% macro span_icon(direction, icon) %}
    <span{{ attrs().addClass(direction == 'right' ? 'ml-1' : 'mr-1') }}>{{ svg_icon(data.icon|default) }}</span>
{% endmacro -%}
