{#-
    Renders the {{color::WERT}}…{{endcolor}} block insert tag.

    Map known colour keys to utility classes; unknown keys fall back to
    "text-<key>". Extend the map (or change the markup) per project as needed.

    - "value"   = the colour key passed in the tag (e.g. "primary", "cris_red")
    - "content" = the already-resolved inner HTML (output raw)
-#}
{%- set map = {primary: 'text-primary', secondary: 'text-secondary', accent: 'text-accent'} -%}
{%- set class = map[value]|default('text-' ~ value) -%}
{{- '<span class="'|raw -}}{{- class -}}{{- '">'|raw -}}{{- content|raw -}}{{- '</span>'|raw -}}
