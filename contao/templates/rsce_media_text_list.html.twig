{% use '@Contao/component/_headline.html.twig' %}
{% use '@Contao/kiss_component/media/_media_text.html.twig' %}
{% use '@Contao/kiss_component/card/_card_attributes.html.twig' %}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set type = 'media_text_list' %}

{% set show_as_card = data.showAsCard|default %}

{% set layout_prefix = show_as_card ? 'card-' : 'layout-' %}
{% set layout_option = styles.media_layout(data.elementLayout|default)|trim %}
{% set layout_class = layout_option ? layout_prefix ~ layout_option : '' %}

{% set media_text_item_attributes = attrs(media_text_item_attributes|default).addClass(layout_class) %}

{% if show_as_card %}
    {% set media_text_item_attributes = attrs()
        .mergeWith(block('card_attributes'))
        .addClass(styles.background(data.backgroundColor|default))
        .mergeWith(media_text_item_attributes|default)
    %}
{% endif %}

{# Reset element layout and background color for list #}
{% set data = data|merge({elementLayout: null, backgroundColor: null}) %}
{% set attributes = attrs(attributes|default).addClass('media_text_list') %}

{# Always set the responsive body-sm on media text cards #}
{% set text_attributes = attrs().addClass('responsive-body-sm').mergeWith(text_attributes|default) %}

{% block headline %}
    {% if item.headline.value|default or item.topline|default %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{% block media_text %}
    <div{{ attrs(media_text_item_attributes|default).addClass('media_text') }}>
        {{ parent() }}
    </div>
{% endblock %}

{% block content %}
    {% for item in list %}
        {{ block('media_text') }}
    {% endfor %}
{% endblock %}
