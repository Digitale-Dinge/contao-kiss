@layer base {
    html {
        @apply box-border;
    }

    .invisible {
        @apply sr-only visible;
    }

    /* Undo Tailwind preflight for lists, components reset them where needed */
    ol,
    ul,
    dl,
    dd {
        list-style: revert;
        margin: revert;
        padding: revert;
    }
}
