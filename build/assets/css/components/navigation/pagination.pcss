/**
 * KISS Pagination Component
 *
 * Contao-only pagination styles.
 *
 * HTML structure:
 *   <nav class="pagination">
 *     <p>Page info</p>
 *     <ul>
 *       <li><a href="#">1</a></li>
 *       <li><strong class="active">2</strong></li>
 *     </ul>
 *   </nav>
 *
 * Sizes: pagination-{sm|lg}
 * Shapes: pagination-{circle|square}
 */
@layer components {
    .pagination {
        --pagination-item-size: 2.5rem;
        --pagination-item-px: .75rem;
        --pagination-text: var(--text-base, 1rem);
        --pagination-radius: var(--radius-field);

        @apply flex! flex-wrap gap-6 items-center justify-between;

        p:first-child {
            @apply m-0!;
        }

        > .sr-only {
            @apply sr-only;
        }

        ul {
            @apply list-none! flex flex-wrap items-center gap-1 sm:gap-2;
        }

        li > :is(a, button, strong, span:not(.sr-only)) {
            @apply inline-flex items-center justify-center gap-2 font-medium leading-tight;

            height: var(--pagination-item-size);
            min-width: var(--pagination-item-size);
            padding-inline: var(--pagination-item-px);
            font-size: var(--pagination-text);
            border-width: var(--border-width-thin);
            border-style: solid;
            border-radius: var(--pagination-radius);
            box-shadow: var(--shadow);
        }

        li > :is(a, button, span:not(.sr-only)) {
            @apply no-underline cursor-pointer select-none transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2;

            background-color: var(--kiss-sys-color-neutral-surface-2);
            color: var(--kiss-sys-color-neutral-on-strong);
            border-color: transparent;

            &:hover {
                background-color: var(--kiss-sys-color-neutral-surface-3);
            }

            &:focus-visible {
                --tw-ring-color: var(--kiss-sys-color-neutral-border-strong);
            }

            &[disabled],
            &.disabled {
                @apply opacity-50 cursor-not-allowed pointer-events-none;
            }
        }

        li > :is(strong, a[aria-current="page"], a.active) {
            @apply cursor-default;

            background-color: var(--kiss-sys-color-brand-primary-solid);
            color: var(--kiss-sys-color-brand-primary-on-solid);
            border-color: var(--kiss-sys-color-brand-primary-border);

            &:hover {
                background-color: var(--kiss-sys-color-brand-primary-solid);
            }
        }
    }

    /* Sizes */
    .pagination-sm {
        --pagination-item-size: 2rem;
        --pagination-item-px: .5rem;
        --pagination-text: var(--text-sm, .875rem);

        @apply gap-0.5;
    }

    /* Medium is the default */

    .pagination-lg {
        --pagination-item-size: 3rem;
        --pagination-item-px: 1rem;
        --pagination-text: var(--text-lg, 1.125rem);

        @apply gap-1.5;
    }

    /* Shapes */
    .pagination-circle {
        --pagination-radius: var(--radius-full);
    }

    .pagination-square {
        --pagination-radius: 0;
    }
}
