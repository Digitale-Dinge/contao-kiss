/**
 * KISS Breadcrumb Component
 *
 * A responsive breadcrumb navigation with threshold-based collapsing.
 * Uses popover component for the dropdown menu.
 *
 * Base: .breadcrumb or .mod_breadcrumb
 * Sizes: breadcrumb-{xs|sm|lg|xl}
 * Colors: breadcrumb-{primary|secondary|tertiary|success|warning|error}
 *
 * Collapsible: Add data-controller="breadcrumb" and mark items with data-breadcrumb-target="item"
 * Configuration (via data attributes, handled by JS):
 *   data-breadcrumb-max-items-value="4"   - Collapse if more than N collapsible items (default: 4)
 *   data-breadcrumb-breakpoint-value="640" - Force collapse below this viewport width (default: 640px)
 */
@layer components {
    .breadcrumb,
    .mod_breadcrumb {
        --breadcrumb-color: var(--kiss-sys-color-brand-primary-solid);
        --breadcrumb-separator-mx: .5rem;
        --breadcrumb-separator-icon: .75rem;
        --breadcrumb-btn-icon: 1rem;
        --breadcrumb-text: var(--text-sm, .875rem);
        --breadcrumb-item-py: .5rem;
        --breadcrumb-item-px: .75rem;

        @apply flex items-center flex-wrap;

        font-size: var(--breadcrumb-text);

        :is(ol, ul) {
            @apply flex items-center flex-wrap m-0 p-0 list-none;
        }

        li {
            @apply flex items-center m-0 p-0;
        }

        a {
            @apply no-underline transition-colors;
        }

        :is(a, .breadcrumb-ellipsis-btn) {
            color: var(--kiss-sys-color-neutral-on-medium);

            &:hover {
                color: var(--breadcrumb-color);
            }
        }

        li:is([aria-current="page"], .active) a {
            color: var(--kiss-sys-color-neutral-on-strong);
        }

        .breadcrumb-separator {
            @apply select-none flex items-center;

            color: var(--kiss-sys-color-neutral-on-light);
            margin-inline: var(--breadcrumb-separator-mx);

            svg {
                width: var(--breadcrumb-separator-icon);
                height: var(--breadcrumb-separator-icon);
            }
        }

        .breadcrumb-ellipsis {
            @apply relative flex items-center;
        }

        .breadcrumb-ellipsis-btn {
            @apply inline-flex items-center justify-center px-1 bg-transparent cursor-pointer border-0 leading-none transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:rounded;

            &:focus-visible {
                --tw-ring-color: color-mix(in oklch, var(--breadcrumb-color) 50%, transparent);
            }

            svg {
                width: var(--breadcrumb-btn-icon);
                height: var(--breadcrumb-btn-icon);
            }
        }

        .breadcrumb-dropdown {
            @apply min-w-40;

            .dropdown-item {
                font-size: var(--breadcrumb-text);
                padding-block: var(--breadcrumb-item-py);
                padding-inline: var(--breadcrumb-item-px);
            }
        }
    }

    /* Colors */
    .breadcrumb-primary {
        --breadcrumb-color: var(--kiss-sys-color-brand-primary-solid);
    }

    .breadcrumb-secondary {
        --breadcrumb-color: var(--kiss-sys-color-brand-secondary-solid);
    }

    .breadcrumb-tertiary {
        --breadcrumb-color: var(--kiss-sys-color-brand-tertiary-solid);
    }

    .breadcrumb-success {
        --breadcrumb-color: var(--kiss-sys-color-status-success-solid);
    }

    .breadcrumb-warning {
        --breadcrumb-color: var(--kiss-sys-color-status-warning-solid);
    }

    .breadcrumb-error {
        --breadcrumb-color: var(--kiss-sys-color-status-error-solid);
    }

    /* Sizes */
    .breadcrumb-xs {
        --breadcrumb-separator-mx: .25rem;
        --breadcrumb-separator-icon: .625rem;
        --breadcrumb-btn-icon: .75rem;
        --breadcrumb-text: var(--text-xs, .75rem);
        --breadcrumb-item-py: .25rem;
        --breadcrumb-item-px: .5rem;
    }

    .breadcrumb-sm {
        --breadcrumb-separator-mx: .375rem;
        --breadcrumb-separator-icon: .625rem;
        --breadcrumb-btn-icon: .875rem;
        --breadcrumb-text: var(--text-sm, .875rem);
        --breadcrumb-item-py: .375rem;
        --breadcrumb-item-px: .625rem;
    }

    /* Medium is the default */

    .breadcrumb-lg {
        --breadcrumb-separator-mx: .625rem;
        --breadcrumb-separator-icon: 1rem;
        --breadcrumb-btn-icon: 1.25rem;
        --breadcrumb-text: var(--text-base, 1rem);
        --breadcrumb-item-py: .625rem;
        --breadcrumb-item-px: 1rem;
    }

    .breadcrumb-xl {
        --breadcrumb-separator-mx: .75rem;
        --breadcrumb-separator-icon: 1.25rem;
        --breadcrumb-btn-icon: 1.5rem;
        --breadcrumb-text: var(--text-lg, 1.125rem);
        --breadcrumb-item-py: .75rem;
        --breadcrumb-item-px: 1.25rem;
    }

    .breadcrumb-home-icon {
        li:first-child a {
            @apply flex items-center gap-1;

            @media (width <= 639px) {
                span:not(.breadcrumb-icon) {
                    @apply sr-only;
                }
            }
        }
    }

    .breadcrumb-icon {
        @apply size-4 shrink-0;
    }
}
