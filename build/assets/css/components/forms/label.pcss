/**
 * KISS Form Label Component
 *
 * Parts:
 *   .label-text    - Main label above input
 *   .helper-text   - Helper text below input
 *   .error-text    - Error message below input
 *
 * Modifiers:
 *   .label-required - Adds required asterisk / See misc
 *
 * Example:
 *   <label class="label-text">Email</label>
 *   <input class="form-input">
 *   <span class="helper-text">We'll never share your email</span>
 */
@layer components {
    .widget > label,
    .label-text {
        @apply block font-medium mb-1.5 text-base;

        color: var(--kiss-sys-color-neutral-on-strong);
    }

    :is(.helper-text, .error-text, .success-text) {
        @apply block mt-1.5 text-base;
    }

    .helper-text {
        color: var(--kiss-sys-color-neutral-on-light);
    }

    .error-text {
        color: var(--kiss-sys-color-status-error-solid);
    }

    .success-text {
        color: var(--kiss-sys-color-status-success-solid);
    }
}
