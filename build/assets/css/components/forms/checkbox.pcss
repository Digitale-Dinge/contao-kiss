/**
 * KISS Checkbox Component
 *
 * Inspired by FlyonUI checkbox with animated checkmark.
 *
 * Base: .form-checkbox
 * Colors: checkbox-{primary|secondary|tertiary|success|warning|error}
 * Sizes: checkbox-{xs|sm|lg|xl}
 * States: disabled, indeterminate
 *
 * Example:
 *   <input type="checkbox" class="form-checkbox checkbox-primary">
 *
 * With Label:
 *   <label class="flex items-center gap-2 cursor-pointer">
 *     <input type="checkbox" class="form-checkbox">
 *     <span>Label text</span>
 *   </label>
 */
@layer components {
    .form-checkbox {
        --input-color: var(--kiss-sys-color-neutral-on-strong);
        --input-border-opacity: 60%;
        --size: 1.5rem;
        --size-padding: .1875rem;

        @apply relative shrink-0 cursor-pointer appearance-none align-middle;

        color: var(--kiss-sys-color-neutral-surface-1);
        width: var(--size);
        height: var(--size);
        padding: var(--size-padding);
        border: 1px solid color-mix(in oklch, var(--input-color) var(--input-border-opacity), transparent);
        border-radius: var(--radius-checkbox, .25rem);
        background-color: transparent;
        transition: background-color .2s, border-color .2s, box-shadow .2s;

        &::before {
            @apply block size-full rotate-45 bg-current opacity-0;

            content: '';
            transition: clip-path .3s, opacity .1s, rotate .3s, translate .3s;
            transition-delay: .1s;
            clip-path: polygon(20% 100%, 20% 80%, 50% 80%, 50% 80%, 70% 80%, 70% 100%);
        }

        &:focus-visible {
            outline: 2px solid color-mix(in oklab, var(--input-color) 30%, transparent);
            outline-offset: 0;
        }

        &:checked,
        &[aria-checked="true"] {
            background-color: var(--input-color);
            border-color: var(--input-color);

            &::before {
                @apply opacity-100;

                clip-path: polygon(20% 100%, 20% 80%, 50% 80%, 50% 0%, 70% 0%, 70% 100%);
            }
        }

        &:indeterminate {
            background-color: var(--input-color);
            border-color: var(--input-color);

            &::before {
                @apply rotate-0 opacity-100;

                translate: 0 -35%;
                clip-path: polygon(20% 100%, 20% 80%, 50% 80%, 50% 80%, 80% 80%, 80% 100%);
            }
        }

        &:disabled {
            @apply cursor-not-allowed opacity-50;
        }
    }

    span:has(> .form-checkbox) {
        @apply flex items-center gap-2 cursor-pointer text-base;

        label {
            margin: 0;
        }
    }

    /* Colors */
    .checkbox-primary {
        --input-color: var(--kiss-sys-color-brand-primary-solid);

        color: var(--kiss-sys-color-brand-primary-on-solid);
    }

    .checkbox-secondary {
        --input-color: var(--kiss-sys-color-brand-secondary-solid);

        color: var(--kiss-sys-color-brand-secondary-on-solid);
    }

    .checkbox-tertiary {
        --input-color: var(--kiss-sys-color-brand-tertiary-solid);

        color: var(--kiss-sys-color-brand-tertiary-on-solid);
    }

    .checkbox-success {
        --input-color: var(--kiss-sys-color-status-success-solid);

        color: var(--kiss-sys-color-status-success-on-solid);
    }

    .checkbox-warning {
        --input-color: var(--kiss-sys-color-status-warning-solid);

        color: var(--kiss-sys-color-status-warning-on-solid);
    }

    .checkbox-error {
        --input-color: var(--kiss-sys-color-status-error-solid);

        color: var(--kiss-sys-color-status-error-on-solid);
    }

    /* Sizes */
    .checkbox-xs {
        --size: 1rem;
        --size-padding: .125rem;
    }

    .checkbox-sm {
        --size: 1.25rem;
        --size-padding: .125rem;
    }

    /* Default is 1.5rem with .1875rem padding (defined in base) */

    .checkbox-lg {
        --size: 1.75rem;
        --size-padding: .25rem;
    }

    .checkbox-xl {
        --size: 2rem;
        --size-padding: .3125rem;
    }

    span:has(> .checkbox-xs) {
        @apply text-xs;
    }

    span:has(> .checkbox-sm) {
        @apply text-sm;
    }

    span:has(> .checkbox-lg) {
        @apply text-lg;
    }

    span:has(> .checkbox-xl) {
        @apply text-xl;
    }
}
