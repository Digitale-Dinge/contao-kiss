@layer components {
    .icon_rich_text {
        @apply flex items-start gap-2;

        > svg {
            width: 1em;
            height: 1em;
            margin-block: calc((1lh - 1em) / 2);

            @apply shrink-0;
        }
    }

    .icon_rich_text-badge {
        @apply gap-4;

        > .badge {
            --badge-px: .75em;
            --badge-py: .75em;
            --badge-text: 1.5em;

            @apply shrink-0;
        }
    }
}
