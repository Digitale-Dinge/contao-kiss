/**
 * KISS Button Component
 *
 * Base: .btn
 * Styles: btn-{soft|outline|text|link}
 * Colors: btn-{primary|secondary|tertiary|success|warning|error}
 * Sizes: btn-{sm|lg}
 * Shapes: btn-{circle|square|wide|block}
 * Effects: btn-shadow-{none|sm|md|lg}, btn-active
 *
 * Example: <button class="btn btn-primary btn-lg btn-shadow-md">Save Document</button>
 */
@layer components {
    .btn {
        --btn-bg: var(--kiss-sys-color-neutral-on-strong);
        --btn-border: var(--kiss-sys-color-neutral-on-strong);
        --btn-color: var(--kiss-sys-color-neutral-surface-1);
        --btn-color-hover: var(--kiss-sys-color-neutral-surface-1);
        --btn-content: var(--kiss-sys-color-neutral-surface-1);
        --btn-ring: var(--kiss-sys-color-neutral-on-strong);
        --btn-hover-opacity: 85%;
        --btn-size: 2.75rem;
        --btn-px: calc(var(--spacing, .25rem) * 4);
        --btn-py: calc(var(--spacing, .25rem) * 2.5);
        --btn-gap: calc(var(--spacing, .25rem) * 2);
        --btn-text: var(--text-base, 1rem);
        --btn-bg-hover: color-mix(in oklch, var(--btn-bg) var(--btn-hover-opacity), transparent);
        --btn-border-hover: color-mix(in oklch, var(--btn-bg) var(--btn-hover-opacity), transparent);

        @apply inline-flex items-center justify-center font-medium leading-tight cursor-pointer select-none transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed;

        font-size: var(--btn-text);
        padding: var(--btn-py) var(--btn-px);
        gap: var(--btn-gap);
        border-width: var(--border-width-thin, 1px);
        border-style: solid;
        border-radius: var(--radius-field, .5rem);
        box-shadow: var(--shadow, none);
        background: var(--btn-bg);
        color: var(--btn-color);
        border-color: var(--btn-border);

        &:hover {
            background: var(--btn-bg-hover);
            color: var(--btn-color-hover);
            border-color: var(--btn-border-hover);
        }

        &:focus-visible {
            --tw-ring-color: color-mix(in oklch, var(--btn-ring) 20%, transparent);
        }

        &:active:not(:disabled) {
            @apply scale-[0.97];
        }
    }

    /* Colors */
    .btn-primary {
        --btn-bg: var(--kiss-sys-color-brand-primary-solid);
        --btn-border: var(--kiss-sys-color-brand-primary-solid);
        --btn-color: var(--kiss-sys-color-brand-primary-on-solid);
        --btn-color-hover: var(--kiss-sys-color-brand-primary-on-solid);
        --btn-content: var(--kiss-sys-color-brand-primary-on-solid);
        --btn-ring: var(--kiss-sys-color-brand-primary-solid);
    }

    .btn-secondary {
        --btn-bg: var(--kiss-sys-color-brand-secondary-solid);
        --btn-border: var(--kiss-sys-color-brand-secondary-solid);
        --btn-color: var(--kiss-sys-color-brand-secondary-on-solid);
        --btn-color-hover: var(--kiss-sys-color-brand-secondary-on-solid);
        --btn-content: var(--kiss-sys-color-brand-secondary-on-solid);
        --btn-ring: var(--kiss-sys-color-brand-secondary-solid);
        --btn-hover-opacity: 90%;
    }

    .btn-tertiary {
        --btn-bg: var(--kiss-sys-color-brand-tertiary-solid);
        --btn-border: var(--kiss-sys-color-brand-tertiary-solid);
        --btn-color: var(--kiss-sys-color-brand-tertiary-on-solid);
        --btn-color-hover: var(--kiss-sys-color-brand-tertiary-on-solid);
        --btn-content: var(--kiss-sys-color-brand-tertiary-on-solid);
        --btn-ring: var(--kiss-sys-color-brand-tertiary-solid);
        --btn-hover-opacity: 90%;
    }

    .btn-success {
        --btn-bg: var(--kiss-sys-color-status-success-solid);
        --btn-border: var(--kiss-sys-color-status-success-solid);
        --btn-color: var(--kiss-sys-color-status-success-on-solid);
        --btn-color-hover: var(--kiss-sys-color-status-success-on-solid);
        --btn-content: var(--kiss-sys-color-status-success-on-solid);
        --btn-ring: var(--kiss-sys-color-status-success-solid);
        --btn-hover-opacity: 90%;
    }

    .btn-warning {
        --btn-bg: var(--kiss-sys-color-status-warning-solid);
        --btn-border: var(--kiss-sys-color-status-warning-solid);
        --btn-color: var(--kiss-sys-color-status-warning-on-solid);
        --btn-color-hover: var(--kiss-sys-color-status-warning-on-solid);
        --btn-content: var(--kiss-sys-color-status-warning-on-solid);
        --btn-ring: var(--kiss-sys-color-status-warning-solid);
        --btn-hover-opacity: 90%;
    }

    .btn-error {
        --btn-bg: var(--kiss-sys-color-status-error-solid);
        --btn-border: var(--kiss-sys-color-status-error-solid);
        --btn-color: var(--kiss-sys-color-status-error-on-solid);
        --btn-color-hover: var(--kiss-sys-color-status-error-on-solid);
        --btn-content: var(--kiss-sys-color-status-error-on-solid);
        --btn-ring: var(--kiss-sys-color-status-error-solid);
        --btn-hover-opacity: 90%;
    }

    /* Variants */
    .btn-soft {
        --btn-border: transparent;
        --btn-border-hover: transparent;
        --btn-color: var(--btn-ring);
        --btn-color-hover: var(--btn-ring);
        --btn-bg: color-mix(in oklch, var(--btn-ring) 10%, transparent);
        --btn-bg-hover: color-mix(in oklch, var(--btn-ring) 20%, transparent);
    }

    .btn-outline {
        --btn-bg: transparent;
        --btn-bg-hover: var(--btn-ring);
        --btn-border: var(--btn-ring);
        --btn-border-hover: var(--btn-ring);
        --btn-color: var(--btn-ring);
        --btn-color-hover: var(--btn-content);
    }

    .btn-text {
        --btn-bg: transparent;
        --btn-border: transparent;
        --btn-border-hover: var(--btn-ring);
        --btn-color: var(--btn-ring);
        --btn-color-hover: var(--btn-ring);
        --btn-bg-hover: color-mix(in oklch, var(--btn-ring) 10%, transparent);

        &:not(:hover, :focus-visible) {
            --btn-px: 0;
        }
    }

    .btn-link {
        color: var(--btn-bg);
        font-size: var(--btn-text);

        &:hover {
            color: var(--btn-bg-hover);
        }
    }

    /* Shadows */
    .btn-shadow-none {
        @apply shadow-none;
    }

    .btn-shadow-sm {
        @apply shadow-sm;

        &:hover {
            @apply shadow-md;
        }

        &:active {
            @apply shadow-none;
        }
    }

    .btn-shadow-md {
        @apply shadow-md;

        &:hover {
            @apply shadow-lg;
        }

        &:active {
            @apply shadow-sm;
        }
    }

    .btn-shadow-lg {
        @apply shadow-lg;

        &:hover {
            @apply shadow-xl;
        }

        &:active {
            @apply shadow-md;
        }
    }

    /* Sizes */
    .btn-sm {
        --btn-size: 2.25rem;
        --btn-px: calc(var(--spacing, .25rem) * 3);
        --btn-py: calc(var(--spacing, .25rem) * 2);
        --btn-gap: calc(var(--spacing, .25rem) * 1.5);
        --btn-text: var(--text-sm, .875rem);
    }

    /* Medium is the default */

    .btn-lg {
        --btn-size: 3.25rem;
        --btn-px: calc(var(--spacing, .25rem) * 5);
        --btn-py: calc(var(--spacing, .25rem) * 3);
        --btn-gap: calc(var(--spacing, .25rem) * 2.5);
        --btn-text: var(--text-lg, 1.125rem);
    }

    /* Shapes */
    .btn-wide {
        --btn-px: calc(var(--spacing, .25rem) * 8);

        @apply max-w-64;
    }

    .btn-block {
        @apply w-full;
    }

    .btn-active {
        @apply scale-95;
    }

    .btn-circle,
    .btn-square {
        --btn-px: 0;
        --btn-py: 0;

        width: var(--btn-size);
        height: var(--btn-size);
        flex-shrink: 0;
    }

    .btn-circle {
        border-radius: 50%;
    }

    .btn-square {
        border-radius: var(--radius-field);
    }
}
