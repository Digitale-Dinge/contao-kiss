@layer components {
    .content-table {
        > div {
            @apply overflow-x-auto;
        }

        table {
            @apply w-full border-collapse text-left;
        }

        caption {
            @apply caption-top mb-2 text-left text-sm text-neutral-on-medium;
        }

        thead {
            @apply border-b-2 border-neutral-border-strong;

            th {
                @apply px-4 py-3 font-semibold;
            }
        }

        tbody {
            > tr {
                @apply border-b border-neutral-border-light;
            }

            td {
                @apply px-4 py-3 align-top;
            }

            th {
                @apply px-4 py-3 font-semibold;
            }
        }

        tfoot {
            @apply border-t-2 border-neutral-border-strong font-semibold;

            td {
                @apply px-4 py-3;
            }
        }
    }
}
