{
    "name": "digitaledinge/contao-kiss",
    "description": "Digitale Dinge's super simple starter kit for Contao CMS",
    "keywords": ["contao", "kiss", "contao kiss", "base framework"],
    "type": "contao-bundle",
    "homepage": "https://github.com/Digitale-Dinge/contao-kiss",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Digitale Dinge GmbH",
            "homepage": "https://digitaledin.ge",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hallo@digitaledin.ge",
        "issues": "https://github.com/Digitale-Dinge/contao-kiss/issues",
        "source": "https://github.com/Digitale-Dinge/contao-kiss"
    },
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^5.7 || ^6.0",
        "digitaledinge/contao-company": "0.1.*",
        "digitaledinge/contao-grid-ratio-widget": "^1.0",
        "doctrine/dbal": "^3.7 || ^4.3",
        "lukasbableck/contao-svg-icon-picker-bundle": "^1.2",
        "madeyourday/contao-rocksolid-custom-elements": "^2.4.15",
        "mvo/contao-group-widget": "^1.6",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/deprecation-contracts": "^3.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/http-kernel": "^7.4.11 || ^8.0",
        "symfony/reprise": "^1.1",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/uid": "^7.4 || ^8.0",
        "twig/intl-extra": "^3.18",
        "twig/twig": "^3.23",
        "zoglo/contao-collection-widget": "^1.0",
        "zoglo/contao-radio-image-widget": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "contao/manager-plugin": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "DigitaleDinge\\ContaoKiss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigitaleDinge\\ContaoKiss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@depcheck",
            "@unit-tests",
            "@php vendor-bin/twig-cs-fixer/vendor/bin/twig-cs-fixer lint",
            "npm --prefix build run lint"
        ],
        "depcheck": "@php vendor/bin/composer-dependency-analyser --config=depcheck.php",
        "twig-cs-fixer": "@php vendor-bin/twig-cs-fixer/vendor/bin/twig-cs-fixer fix -v",
        "unit-tests": "@php vendor/bin/phpunit --fail-on-phpunit-notice"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": false
        },
        "contao-manager-plugin": "DigitaleDinge\\ContaoKiss\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "contao-components/installer": true,
            "php-http/discovery": false,
            "contao/manager-plugin": true
        }
    }
}
