{
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/zoglo/contao-rector"
        }
    ],
    "require": {
        "contao/contao-rector": "dev-fix/set_lists",
        "rector/rector": "^2.7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.15"
        },
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
